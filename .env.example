# Set these in the Vercel project; never commit real credentials.
SITE_URL=https://build.lockdowel.com
# Optional URL-prefix verification token (DNS verification also works).
GOOGLE_SITE_VERIFICATION=
# Enable Web Analytics in Vercel first, then redeploy with this true.
WEB_ANALYTICS_ENABLED=false
# Custom events require a supported paid Vercel plan.
WEB_ANALYTICS_EVENTS=false
# HTTPS receiver that accepts the JSON contract in docs/seo-release.md.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
# Leave false outside an intentional local integration test.
INQUIRY_ALLOW_LOCAL=false
